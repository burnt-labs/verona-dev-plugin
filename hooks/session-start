#!/usr/bin/env bash
# SessionStart hook for verona-dev-plugin (Cursor, Claude Code, SDK fallback)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

STATIC_CONTEXT='For Verona/Xion development in verona-dev-plugin, read and use the verona-dev skill (skills/verona-dev/SKILL.md). It routes MetaAccount/toolkit work to in-plugin skills and xiond/chain operations to verona-bin.'

SKILL_PATH="${PLUGIN_ROOT}/skills/verona-dev/SKILL.md"
session_context="$STATIC_CONTEXT"

if [ -f "$SKILL_PATH" ]; then
  skill_preview="$(head -n 25 "$SKILL_PATH" 2>/dev/null || true)"
  if [ -n "$skill_preview" ]; then
    session_context="${STATIC_CONTEXT}

Skill preview (read the full skill for routing):
${skill_preview}"
  fi
fi

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

session_context_escaped="$(escape_for_json "$session_context" 2>/dev/null || escape_for_json "$STATIC_CONTEXT")"

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context_escaped"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context_escaped"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context_escaped"
fi

exit 0
