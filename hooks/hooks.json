{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'root=\"${CLAUDE_PLUGIN_ROOT:-}\"; [ -n \"$root\" ] || root=\"${PLUGIN_ROOT:-}\"; exec \"$root/hooks/session-start\"'",
            "statusMessage": "Loading Verona entry context",
            "async": false
          }
        ]
      }
    ]
  }
}
